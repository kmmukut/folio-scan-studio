# For docker compose: copy to .env and set a strong password.
SCAN_STUDIO_ADMIN_USER=admin
SCAN_STUDIO_ADMIN_PASSWORD=
# One or more CUPS servers (hostname or IP, optionally :port).
# Examples: CUPS_SERVERS=198.51.100.2:631,203.0.113.70:631
CUPS_SERVERS=198.51.100.2:631
# Set your preferred default printer in Folio > Devices, not here.
USER_PRINT_MAX_MB=256
