# For docker compose: copy to .env and set a strong password (12+ characters).
SCAN_STUDIO_ADMIN_USER=admin
SCAN_STUDIO_ADMIN_PASSWORD=

# One or more CUPS servers (hostname or IP, optionally :port), comma-separated.
# Examples: CUPS_SERVERS=cups:631   or   CUPS_SERVERS=192.168.1.10:631,192.168.1.11:631
CUPS_SERVERS=

# Behind an HTTPS reverse proxy: set COOKIE_SECURE=true and trust the proxy's
# address or Docker network, e.g. FORWARDED_ALLOW_IPS=172.19.0.0/16
COOKIE_SECURE=false
FORWARDED_ALLOW_IPS=127.0.0.1

# Set your preferred default printer in Folio > Devices, not here.
USER_PRINT_MAX_MB=256
