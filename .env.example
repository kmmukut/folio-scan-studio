# Folio Scan Studio settings. Copy to .env, fill in the password, then:
#   chmod 600 .env && docker compose up -d
# In Portainer, add these as stack environment variables instead.
# Everything except the password is optional; the defaults are shown.

# --- Required ------------------------------------------------------------
# The first administrator, created on first start only (when no accounts
# exist). Use 12 or more characters. Change it later in Folio, not here.
SCAN_STUDIO_ADMIN_PASSWORD=
SCAN_STUDIO_ADMIN_USER=admin

# --- Image ---------------------------------------------------------------
# "full": everything, including searchable PDFs (OCR) and automatic
#         straightening suggestions (about 1.2 GB).
# "lite": for Raspberry Pi-class computers; leaves out those two (about 660 MB).
FOLIO_EDITION=full
# "0.14" receives 0.14.x fixes when you pull; "0.14.0" stays exactly there.
FOLIO_VERSION=0.14
# The port Folio is reachable on from other computers.
FOLIO_PORT=8870

# --- Time zone -------------------------------------------------------------
# Decides which day and month a print counts in, e.g. Europe/Berlin,
# America/New_York, Asia/Dhaka.
TZ=UTC

# --- Behind a reverse proxy (HTTPS) ------------------------------------
# Set COOKIE_SECURE=true when Folio is served over HTTPS, and trust the
# proxy's address or Docker network so each visitor keeps their own address
# for sign-in and guest limits, e.g. FORWARDED_ALLOW_IPS=172.19.0.0/16
COOKIE_SECURE=false
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Printing ----------------------------------------------------------------
# Optional. Print servers (computers running CUPS) can be added in
# Folio > Devices > Print servers. List any here that should always be used:
# e.g. CUPS_SERVERS=cups:631   or   CUPS_SERVERS=192.168.1.10:631,192.168.1.11:631
CUPS_SERVERS=
# Only with compose.cups.yaml (a CUPS server next to Folio): its
# administrator login, which you then connect in Devices > Print servers.
CUPS_ADMIN=cupsadmin
CUPS_ADMIN_PASSWORD=
# Largest file a signed-in person may upload to print, in MB (64-2048).
# Guests are always limited to 10 MB.
USER_PRINT_MAX_MB=256

# --- Scanning ----------------------------------------------------------------
# Scanners are added in Folio > Devices by IP address. "on" also finds
# eSCL/WSD scanners by multicast, which usually needs the container to share
# the host's network (network_mode: host).
FOLIO_AIRSCAN_DISCOVERY=off
# Longest a scan may take, and how long a scanner gets to stop cleanly
# when cancelled, in seconds.
SCAN_TIMEOUT_SECONDS=900
SCAN_GRACE_SECONDS=30

# --- Performance ---------------------------------------------------------
# Full-resolution page decodes allowed at once. Blank: 2, or 1 on a
# single-core host. Lower it to 1 on hosts with little memory.
FOLIO_RENDER_CONCURRENCY=
